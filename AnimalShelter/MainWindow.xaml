<Window x:Class="AnimalShelter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimalShelter"
        mc:Ignorable="d" Title="Приют для домашних животных" Height="760" Width="1300" WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="SideMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#4A6FA5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#4A6FA5" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="60" Height="60" CornerRadius="40" Background="White" Margin="0,0,12,0">
                        <Image Source="Icons/Logo.png" Width="60" Height="60"/>
                    </Border>
                    <TextBlock Text="Приют для домашних животных" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtUserName" Text="Пользователь" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse Width="35" Height="35" Fill="#FFD166"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="НАВИГАЦИЯ" FontSize="12" FontWeight="Bold" Foreground="#9E9E9E" Margin="20,0,0,10"/>
                    <Button Content="🏠  Главная" Style="{StaticResource SideMenuButtonStyle}" Click="BtnHome_Click"/>
                    <Button Content="🐕  Животные" Style="{StaticResource SideMenuButtonStyle}" Click="BtnAnimals_Click"/>
                    <Button Content="👥  Посетители" Style="{StaticResource SideMenuButtonStyle}" Click="BtnVisitors_Click"/>
                    <Button x:Name="BtnEmployees" Content="👨‍💼  Сотрудники" Style="{StaticResource SideMenuButtonStyle}" Click="BtnEmployees_Click"/>
                    <Button Content="❤️  Усыновления" Style="{StaticResource SideMenuButtonStyle}" Click="BtnAdoptions_Click"/>
                    <Button Content="📊  Отчёты" Style="{StaticResource SideMenuButtonStyle}" Click="BtnReports_Click"/>
                    <Separator Margin="15,10"/>
                    <Button x:Name="BtnSettings" Content="⚙️  Настройки" Style="{StaticResource SideMenuButtonStyle}" Click="BtnSettings_Click"/>
                    <Button Content="🚪  Выход" Style="{StaticResource SideMenuButtonStyle}" Click="BtnExit_Click"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#F5F7FA" Padding="20">
                <ContentControl x:Name="MainContent"/>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#ECEFF1" Padding="15,8">
            <Grid>
                <TextBlock Text="© 2026 Приют для домашних животных." FontSize="12" Foreground="#757575" HorizontalAlignment="Left"/>
                <TextBlock Text="" FontSize="12" Foreground="#757575" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>