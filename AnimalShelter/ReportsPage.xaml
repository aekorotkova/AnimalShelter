<UserControl x:Class="AnimalShelter.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="Отчёты" FontSize="22" FontWeight="Bold" Foreground="#4A6FA5"/>
        </Border>
        <TabControl Grid.Row="1" Margin="20" Background="White" BorderBrush="#E0E0E0" FontSize="13" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="🐾 Животные в приюте">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 Обновить" Height="32" Padding="14,0" Margin="0,0,10,0" Background="#90A4AE" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnRefreshInShelter_Click"/>
                        <Button Content="📥 Экспорт в Excel" Height="32" Padding="14,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnExportInShelter_Click"/>
                        <TextBlock x:Name="TxtInShelterCount" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13" Foreground="#424242"/>
                    </StackPanel>
                    <DataGrid x:Name="DgInShelter" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" Background="White" RowBackground="White"
                              AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AnimalID}" Width="50"/>
                            <DataGridTextColumn Header="Кличка" Binding="{Binding Nickname}" Width="130"/>
                            <DataGridTextColumn Header="Вид" Binding="{Binding SpeciesName}" Width="110"/>
                            <DataGridTextColumn Header="Порода" Binding="{Binding BreedName}" Width="140"/>
                            <DataGridTextColumn Header="Возраст" Binding="{Binding Age}" Width="70"/>
                            <DataGridTextColumn Header="Пол" Binding="{Binding GenderName}" Width="90"/>
                            <DataGridTextColumn Header="Здоровье" Binding="{Binding HealthStatus}" Width="*"/>
                            <DataGridTextColumn Header="Поступил" Binding="{Binding AdmissionDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="❤ Усыновлённые">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 Обновить" Height="32" Padding="14,0" Margin="0,0,10,0" Background="#90A4AE" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnRefreshAdopted_Click"/>
                        <Button Content="📥 Экспорт в Excel" Height="32" Padding="14,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnExportAdopted_Click"/>
                        <TextBlock x:Name="TxtAdoptedCount" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="13" Foreground="#424242"/>
                    </StackPanel>
                    <DataGrid x:Name="DgAdopted" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" Background="White" RowBackground="White"
                              AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AnimalID}" Width="50"/>
                            <DataGridTextColumn Header="Кличка" Binding="{Binding Nickname}" Width="130"/>
                            <DataGridTextColumn Header="Вид" Binding="{Binding SpeciesName}" Width="110"/>
                            <DataGridTextColumn Header="Порода" Binding="{Binding BreedName}" Width="140"/>
                            <DataGridTextColumn Header="Новый владелец" Binding="{Binding VisitorName}" Width="*"/>
                            <DataGridTextColumn Header="Оформил" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding AdoptionDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="📊 По видам">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 Обновить" Height="32" Padding="14,0" Margin="0,0,10,0" Background="#90A4AE" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnRefreshSpecies_Click"/>
                        <Button Content="📥 Экспорт в Excel" Height="32" Padding="14,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnExportSpecies_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="DgSpecies" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" Background="White" RowBackground="White"
                              AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Вид" Binding="{Binding SpeciesName}" Width="200"/>
                            <DataGridTextColumn Header="Всего" Binding="{Binding TotalCount}" Width="120"/>
                            <DataGridTextColumn Header="В приюте" Binding="{Binding InShelterCount}" Width="150"/>
                            <DataGridTextColumn Header="Усыновлено" Binding="{Binding AdoptedCount}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="📅 За период">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#424242"/>
                        <DatePicker x:Name="DpFrom" Width="140" Height="32" FontSize="13" Margin="0,0,15,0"/>
                        <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#424242"/>
                        <DatePicker x:Name="DpTo" Width="140" Height="32" FontSize="13" Margin="0,0,15,0"/>
                        <Button Content="🔍 Найти" Height="32" Padding="14,0" Margin="0,0,10,0" Background="#4A6FA5" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnBuildPeriod_Click"/>
                        <Button Content="📥 Экспорт в Excel" Height="32" Padding="14,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnExportPeriod_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="DgPeriod" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" Background="White" RowBackground="White"
                              AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AdoptionID}" Width="60"/>
                            <DataGridTextColumn Header="Животное" Binding="{Binding AnimalNickname}" Width="150"/>
                            <DataGridTextColumn Header="Новый владелец" Binding="{Binding VisitorName}" Width="*"/>
                            <DataGridTextColumn Header="Оформил" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Дата"  Binding="{Binding AdoptionDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="🔔 Напоминания">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Показать контакты за ближайшие:" VerticalAlignment="Center" FontSize="13" Foreground="#424242" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbContactDays" Width="120" Height="32" FontSize="13" SelectedIndex="2" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="7 дней"/>
                            <ComboBoxItem Content="14 дней"/>
                            <ComboBoxItem Content="30 дней"/>
                            <ComboBoxItem Content="90 дней"/>
                        </ComboBox>
                        <Button Content="🔍 Показать" Height="32" Padding="14,0" Margin="15,0,10,0" Background="#4A6FA5" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnBuildReminders_Click"/>
                        <Button Content="📥 Экспорт в Excel" Height="32" Padding="14,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnExportReminders_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="DgReminders" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" Background="White" RowBackground="White"
                              AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AdoptionID}" Width="60"/>
                            <DataGridTextColumn Header="Животное" Binding="{Binding AnimalNickname}" Width="150"/>
                            <DataGridTextColumn Header="Владелец" Binding="{Binding VisitorName}" Width="*"/>
                            <DataGridTextColumn Header="Оформил" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Дата усыновления" Binding="{Binding AdoptionDate, StringFormat=dd.MM.yyyy}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>