<UserControl x:Class="AnimalShelter.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="#F5F7FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25">
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🐾" FontSize="42" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtWelcome" Text="Добро пожаловать!" FontSize="20" FontWeight="Bold" Foreground="#4A6FA5"/>
                            <TextBlock x:Name="TxtSubWelcome" Text="Выберите раздел в меню слева или воспользуйтесь быстрыми действиями ниже." FontSize="13" Foreground="#757575" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,15">
                    <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Животных в приюте" FontSize="12" Foreground="#757575"/>
                            <TextBlock x:Name="TxtAnimalsInShelter" Text="0" FontSize="32" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Усыновлено за месяц" FontSize="12" Foreground="#757575"/>
                            <TextBlock x:Name="TxtAdoptedLastMonth" Text="0" FontSize="32" FontWeight="Bold" Foreground="#4CAF50" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Всего посетителей" FontSize="12" Foreground="#757575"/>
                            <TextBlock x:Name="TxtVisitors" Text="0" FontSize="32" FontWeight="Bold" Foreground="#7E57C2" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="18" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Сотрудников" FontSize="12" Foreground="#757575"/>
                            <TextBlock x:Name="TxtEmployees" Text="0" FontSize="32" FontWeight="Bold" Foreground="#FF9800" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🔔 Напоминания о контакте" FontSize="16" FontWeight="Bold" Foreground="#E57373" Margin="0,0,0,12"/>
                            <TextBlock Text="Владельцы, с которыми нужно связаться в ближайшие 7 дней:" FontSize="12" Foreground="#757575" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="ListReminders">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF3E0" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" FontSize="13">
                                                    <Run Text="{Binding AnimalNickname}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding VisitorName}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#757575" Margin="0,2,0,0">
                                                    <Run Text="Усыновлён: "/>
                                                    <Run Text="{Binding AdoptionDate, StringFormat=dd.MM.yyyy}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtNoReminders" Text="✅ Всё под контролем — напоминаний нет." FontSize="13" Foreground="#4CAF50" FontStyle="Italic" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🐾 Давно в приюте" FontSize="16" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,12"/>
                            <TextBlock Text="Эти животные ждут своего хозяина дольше всех:" FontSize="12" Foreground="#757575" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="ListOldestAnimals">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#E3F2FD" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" FontSize="13">
                                                    <Run Text="{Binding Nickname}"/>
                                                    <Run Text=" ("/>
                                                    <Run Text="{Binding SpeciesName}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#757575" Margin="0,2,0,0">
                                                    <Run Text="В приюте с "/>
                                                    <Run Text="{Binding AdmissionDate, StringFormat=dd.MM.yyyy}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚡ Быстрые действия" FontSize="16" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,15"/>
                        <UniformGrid Rows="1" Columns="4">
                            <Button Content="➕  Добавить животное" Height="60" Margin="0,0,10,0" Background="#4A6FA5" Foreground="White" BorderThickness="0"
                                    FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="BtnQuickAddAnimal_Click"/>
                            <Button Content="➕  Добавить посетителя" Height="60" Margin="0,0,10,0" Background="#7E57C2" Foreground="White" BorderThickness="0"
                                    FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="BtnQuickAddVisitor_Click"/>
                            <Button Content="📊  Все отчёты" Height="60" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"
                                    FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="BtnGoReports_Click"/>
                            <Button Content="📋  Усыновления" Height="60" Background="#FF9800" Foreground="White" BorderThickness="0"
                                    FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="BtnGoAdoptions_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>