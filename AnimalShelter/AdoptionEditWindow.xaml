<Window x:Class="AnimalShelter.AdoptionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Оформление усыновления" Width="500" SizeToContent="Height" MinHeight="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D9E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#4A6FA5" Padding="20,15">
            <TextBlock Text="Оформление усыновления" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>
        <Border Grid.Row="1" Padding="25,20">
            <StackPanel>
                <TextBlock Text="Животное *" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CmbAnimal" Style="{StaticResource ComboStyle}" DisplayMemberPath="Item2" SelectedValuePath="Item1" Margin="0,0,0,12"/>
                <TextBlock Text="Посетитель (новый владелец) *" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CmbVisitor" Style="{StaticResource ComboStyle}" DisplayMemberPath="Item2" SelectedValuePath="Item1" Margin="0,0,0,12"/>
                <TextBlock Text="Сотрудник (оформил) *" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CmbEmployee" Style="{StaticResource ComboStyle}" DisplayMemberPath="Item2" SelectedValuePath="Item1" Margin="0,0,0,12"/>
                <TextBlock Text="Дата усыновления *" Style="{StaticResource LabelStyle}"/>
                <DatePicker x:Name="DpAdoptionDate" Height="35" FontSize="14" Margin="0,0,0,12"/>
                <TextBlock Text="Дата следующего контакта" Style="{StaticResource LabelStyle}"/>
                <DatePicker x:Name="DpNextContact" Height="35" FontSize="14" Margin="0,0,0,12"/>
                <TextBlock Text="Заметка" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtNotes" Height="70" FontSize="14" Padding="8,4" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderBrush="#D0D9E8" BorderThickness="1" Background="White"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="#ECEFF1" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Оформить" Width="120" Height="35" Margin="0,0,10,0" Background="#4A6FA5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnSave_Click"/>
                <Button Content="Отмена" Width="100" Height="35" Background="#B0BEC5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>