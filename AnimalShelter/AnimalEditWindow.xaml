<Window x:Class="AnimalShelter.AnimalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Животное" Height="780" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D9E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D9E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#4A6FA5" Padding="20,15">
            <TextBlock x:Name="TxtHeader" Text="Добавление животного" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>
        <Border Grid.Row="1" Padding="25,20">
            <StackPanel>
                <Border Background="#F9FAFB" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="80" Height="80" CornerRadius="8" Background="#ECEFF1" BorderBrush="#D0D9E8" BorderThickness="1">
                            <Image x:Name="ImgPhoto" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Фото животного" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#424242" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="📷 Загрузить" Height="30" Width="120" Background="#4A6FA5" Foreground="White" BorderThickness="0"
                                        FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0" Click="BtnLoadPhoto_Click"/>
                                <Button Content="🗑 Удалить" Height="30" Width="100" Background="#E57373" Foreground="White" BorderThickness="0"
                                        FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="BtnRemovePhoto_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="Кличка *" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtNickname" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>
                <TextBlock Text="Вид *" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CmbSpecies" Style="{StaticResource ComboStyle}" DisplayMemberPath="Item2" SelectedValuePath="Item1" SelectionChanged="CmbSpecies_SelectionChanged" Margin="0,0,0,12"/>
                <TextBlock Text="Порода *" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CmbBreed" Style="{StaticResource ComboStyle}" DisplayMemberPath="Item2" SelectedValuePath="Item1" Margin="0,0,0,12"/>
                <TextBlock Text="Возраст (лет)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtAge" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>
                <TextBlock Text="Пол *" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CmbGender" Style="{StaticResource ComboStyle}" DisplayMemberPath="Item2" SelectedValuePath="Item1" Margin="0,0,0,12"/>
                <TextBlock Text="Состояние здоровья" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtHealth" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>
                <TextBlock Text="Дата поступления" Style="{StaticResource LabelStyle}"/>
                <DatePicker x:Name="DpAdmissionDate" Height="35" FontSize="14" Margin="0,0,0,12"/>
                <CheckBox x:Name="ChkIsAdopted" Content="Усыновлён" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="#ECEFF1" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,10,0" Background="#4A6FA5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnSave_Click"/>
                <Button Content="Отмена" Width="100" Height="35" Background="#B0BEC5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>