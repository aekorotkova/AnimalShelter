<UserControl x:Class="AnimalShelter.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="Настройки" FontSize="22" FontWeight="Bold" Foreground="#4A6FA5"/>
        </Border>
        <TabControl Grid.Row="1" Margin="20" Background="White" BorderBrush="#E0E0E0" FontSize="13" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="📚 Справочники">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Справочник:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14" Foreground="#424242"/>
                        <ComboBox x:Name="CmbDictType" Width="220" Height="32" FontSize="13" VerticalContentAlignment="Center" SelectionChanged="CmbDictType_SelectionChanged">
                            <ComboBoxItem Content="Виды животных" IsSelected="True"/>
                            <ComboBoxItem Content="Породы"/>
                            <ComboBoxItem Content="Пол"/>
                            <ComboBoxItem Content="Цели визита"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnDictAdd" Content="➕ Добавить" Height="32" Padding="14,0" Margin="0,0,10,0" Background="#4A6FA5" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnDictAdd_Click"/>
                        <Button x:Name="BtnDictEdit" Content="✏ Изменить" Height="32" Padding="14,0" Margin="0,0,10,0" Background="#FFB74D" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnDictEdit_Click"/>
                        <Button x:Name="BtnDictDelete" Content="🗑 Удалить" Height="32" Padding="14,0" Margin="0,0,10,0" Background="#E57373" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnDictDelete_Click"/>
                        <Button Content="🔄 Обновить" Height="32" Padding="14,0" Background="#90A4AE" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" Click="BtnDictRefresh_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="DgDictionary" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" Background="White" RowBackground="White"
                              AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Родительский вид" Binding="{Binding ParentName}" Width="250"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="🔒 Смена пароля">
                <Grid Margin="30">
                    <StackPanel MaxWidth="450" HorizontalAlignment="Left">
                        <TextBlock Text="Смена пароля текущего пользователя" FontSize="16" FontWeight="Bold" Foreground="#4A6FA5" Margin="0,0,0,20"/>
                        <TextBlock x:Name="TxtCurrentUser" FontSize="13" Foreground="#757575" Margin="0,0,0,20"/>
                        <TextBlock Text="Старый пароль *" FontSize="13" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtOldPassword" Height="35" FontSize="14" Padding="8,0" Margin="0,0,0,15"
                                     BorderBrush="#D0D9E8" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Новый пароль *" FontSize="13" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtNewPassword" Height="35" FontSize="14" Padding="8,0" Margin="0,0,0,15"
                                     BorderBrush="#D0D9E8" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Подтверждение нового пароля *" FontSize="13" FontWeight="SemiBold" Foreground="#424242" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtConfirmPassword" Height="35" FontSize="14" Padding="8,0" Margin="0,0,0,20"
                                     BorderBrush="#D0D9E8" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <Button Content="🔒 Сменить пароль" Height="40" Padding="20,0" Background="#4A6FA5" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Left" Click="BtnChangePassword_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>