<Window x:Class="AnimalShelter.AnimalCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Карточка животного" Width="720" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#4A6FA5" Padding="20,15">
            <TextBlock x:Name="TxtHeader" Text="Карточка животного" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>
        <Border Grid.Row="1" Padding="25,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="220" Height="220" CornerRadius="10" Background="#ECEFF1" BorderBrush="#D0D9E8" BorderThickness="1">
                    <Image x:Name="ImgPhoto" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="25,0,0,0">
                    <TextBlock x:Name="TxtNickname" FontSize="22" FontWeight="Bold" Foreground="#4A6FA5"/>
                    <TextBlock x:Name="TxtSubtitle" FontSize="14" Foreground="#757575" Margin="0,4,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Вид:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSpecies" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Порода:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtBreed" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Возраст:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtAge" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Пол:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtGender" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Поступил:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtAdmission" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Статус:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtStatus" Margin="0,0,0,6"/>
                    </Grid>
                    <TextBlock Text="Состояние здоровья:" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBlock x:Name="TxtHealth" TextWrapping="Wrap" Foreground="#424242"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#ECEFF1" Padding="15,10">
            <Button Content="Закрыть" Width="120" Height="35" HorizontalAlignment="Right" Background="#4A6FA5" 
                    Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>